{
  "manifest_version": 2,
  "name": "WorkInBox Thunderbird Connector",
  "description": "Provides Thunderbird-side UI and bridge functions for WorkInBox.",
  "version": "0.2.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "workinbox-connector@workinbox.local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "messagesRead",
    "messagesTags",
    "messagesTagsList",
    "storage",
    "downloads",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "workinbox_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "32": "icons/workinbox.svg",
    "64": "icons/workinbox.svg"
  },
  "browser_action": {
    "default_title": "WorkInBox",
    "default_label": "WorkInBox",
    "default_popup": "popup.html",
    "default_icon": "icons/workinbox.svg",
    "allowed_spaces": [
      "mail"
    ]
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}

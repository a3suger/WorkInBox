{
  "manifest_version": 2,
  "name": "WorkInBox Thunderbird Connector",
  "description": "Provides Thunderbird-side UI and bridge functions for WorkInBox.",
  "version": "0.3.19",
  "browser_specific_settings": {
    "gecko": {
      "id": "workinbox-connector@workinbox.local",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesUpdate",
    "messagesTags",
    "messagesTagsList",
    "compose",
    "storage",
    "downloads",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "workinbox_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "experiment_apis": {
    "glodaIndexing": {
      "schema": "experiments/gloda_indexing/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "glodaIndexing"
          ]
        ],
        "script": "experiments/gloda_indexing/implementation.js"
      }
    },
    "tabTitle": {
      "schema": "experiments/tab_title/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "tabTitle"
          ]
        ],
        "script": "experiments/tab_title/implementation.js"
      }
    },
    "imapAccounts": {
      "schema": "experiments/imap_accounts/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "imapAccounts"
          ]
        ],
        "script": "experiments/imap_accounts/implementation.js"
      }
    },
    "mailViews": {
      "schema": "experiments/mail_views/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "mailViews"
          ]
        ],
        "script": "experiments/mail_views/implementation.js"
      }
    },
    "tasksSpace": {
      "schema": "experiments/tasks_space/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["tasksSpace"]],
        "script": "experiments/tasks_space/implementation.js"
      }
    }
  },
  "icons": {
    "32": "icons/workinbox.svg",
    "64": "icons/workinbox.svg"
  },
  "message_display_action": {
    "default_title": "WIB操作メニュー",
    "default_popup": "message_menu.html",
    "default_icon": "icons/workinbox.svg"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
